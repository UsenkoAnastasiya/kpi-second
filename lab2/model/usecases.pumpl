@startuml
left to right direction
skinparam packageStyle rectangle

actor User
actor Reader
actor Librarian
actor "Notification Service" as NS << External System >>

User <|-- Reader
User <|-- Librarian

rectangle "Library System" {
  usecase "Пошук книг" as UC_Search
  usecase "Видати книгу" as UC_Loan
  usecase "Перевірити читача" as UC_CheckReader
  usecase "Повернути книгу" as UC_Return
  usecase "Нагадати про строк" as UC_Notify
  usecase "Повідомити про прострочення" as UC_OverdueNotice
}

Reader --> UC_Search
Librarian --> UC_Loan
Librarian --> UC_Return

UC_Loan ..> UC_CheckReader : <<include>>
UC_Return <.. UC_OverdueNotice : <<extend>>
UC_Notify --> NS
@enduml